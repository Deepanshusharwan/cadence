<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-variant-only override, merged on top of the main manifest.
     Android blocks plain HTTP by default since API 28, and local dev
     backends (docker compose's Caddy on plain :80, or a bare local
     uvicorn dev server on :8000) aren't TLS, so debug builds need
     cleartext allowed to reach them over LAN. Release never gets this:
     real deployments always sit behind Caddy's automatic HTTPS
     (docs/deployment.md), so production traffic stays HTTPS-only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
