NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (https://dashboard.clerk.com -> your app -> API Keys) — the
# publishable key must match the CLERK_* values in backend/.env.example,
# since both sides need to agree on the same Clerk project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required so clerkMiddleware's auth.protect() sends unauthenticated visitors
# to our own branded pages instead of Clerk's hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
