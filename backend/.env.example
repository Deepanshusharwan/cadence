DATABASE_URL=postgresql+psycopg2://cadence:cadence@localhost:5433/cadence

# Clerk (https://dashboard.clerk.com -> your app -> API Keys / JWKS)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>

# Local dev only — bypasses Clerk verification entirely and treats every
# request as a single fixed dev user. Never set this in a real deployment.
DEV_AUTH_BYPASS=false

CORS_ORIGINS=["http://localhost:3000"]
