DATABASE_URL=postgresql+psycopg2://cadence:cadence@localhost:5433/cadence

# Clerk (https://dashboard.clerk.com -> your app -> API Keys / JWKS)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>

# Local dev only — bypasses Clerk verification entirely and treats every
# request as a single fixed dev user. Never set this in a real deployment.
DEV_AUTH_BYPASS=false

CORS_ORIGINS=["http://localhost:3000"]

# Emails allowed to read GET /feedback (checked against the requesting
# user's Clerk primary email). Add more by appending to this list.
ADMIN_EMAILS=[]

# Lemon Squeezy (https://app.lemonsqueezy.com -> Settings -> Webhooks, and
# Store -> Products for variant ids). The webhook secret you set when
# creating the webhook endpoint in the Lemon Squeezy dashboard — with this
# unset, POST /webhooks/lemonsqueezy rejects every request.
LEMONSQUEEZY_WEBHOOK_SECRET=

# variant id -> plan, e.g. {"123456": "plus", "123457": "plus"} for each
# Plus billing cadence (monthly/quarterly/annual/lifetime all map to the
# same "plus" plan — cadence doesn't change the tier).
LEMONSQUEEZY_VARIANT_PLANS={}

# Settings -> API. Used server-side to create checkout sessions via the API
# (POST /billing/checkout) instead of static hosted checkout links, so we
# can force skip_trial for a customer who's already used a trial on a
# different variant. Never sent to the frontend.
LEMONSQUEEZY_API_KEY=

# Settings -> Store. Required by the Checkout API alongside the variant id.
LEMONSQUEEZY_STORE_ID=
